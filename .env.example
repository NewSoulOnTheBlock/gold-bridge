# Copy to .env for local dev. On Render these are set as service env vars (secrets NOT committed).
DATABASE_URL=postgres://user:pass@localhost:5432/goldbridge
SHARED_SECRET=CHANGE_ME_must_match_DayZ_config
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
TOKEN_ADDRESS=0xC99C8D7C4fA25a7459F78b9Fbb4c66deeD18E9bF
# Treasury wallet that holds $GOLD supply + ETH for gas. Needed only for /claim transfers.
# Leave unset to run in accrue-only mode (rewards still recorded; claims return 503).
TREASURY_PRIVATE_KEY=
# Public URL of this service, used to build link URLs shown to players.
PUBLIC_BASE_URL=https://gold-bridge.onrender.com
# Per-player per-day cap (whole tokens).
DAILY_CAP=500
# Optional CSV of DayZ server IPs allowed to POST /reward and /link/request.
DAYZ_IP_ALLOWLIST=
